# Build-time (Vite, public in the bundle). Defaults suit the local devnet.
VITE_RPC=
VITE_CHAIN_ID=
VITE_WALLET_RPC=
VITE_GNOWEB=
VITE_SITE_URL=
# Namespace of the GnoRadio packages on a public chain, e.g. nym-alexiscolin000/gnoradio (gnoradio locally).
VITE_GNORADIO_NS=
# PostHog project key (phc_…, public): anonymous audience measurement; empty, nothing loads.
VITE_POSTHOG_KEY=

# Netlify function secrets (set in Netlify, never commit values).
BOT_SIGNING_KEY=
OPENAI_API_KEY=
SYNC_ROBOT=
BOT_MNEMONIC=
BOT_RPC=
