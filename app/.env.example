# Build-time (Vite, public in the bundle). Defaults suit the local devnet.
# VITE_NETWORK picks the chain: dev, onyx or mainnet (a production build
# without it is onyx). Each of the four below overrides one value of it.
VITE_NETWORK=
VITE_RPC=
VITE_CHAIN_ID=
VITE_WALLET_RPC=
VITE_GNOWEB=
VITE_SITE_URL=
# Namespace of the GnoRadio packages on a public chain, e.g. nym-alexiscolin000/gnoradio (gnoradio locally).
VITE_GNORADIO_NS=
# PostHog project key (phc_…, public): anonymous audience measurement; empty, nothing loads.
VITE_POSTHOG_KEY=

# Netlify function secrets (set in Netlify, never commit values).
BOT_SIGNING_KEY=
OPENAI_API_KEY=
# Defaults to VITE_NETWORK's public RPC.
BOT_RPC=
# Audius and Jamendo pointers (netlify/refs.ts, read by /api/meta only): an Audius API key
# (api.audius.co/plans) and a Jamendo client id (devportal.jamendo.com). Without them,
# Audius still answers with app_name; Jamendo pointers stay unnamed and silent.
AUDIUS_API_KEY=
JAMENDO_CLIENT_ID=
