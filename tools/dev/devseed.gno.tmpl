// Package devseed loads the curated catalogue (and the Audius/Jamendo pointers) on a
// local devnet. Generated by tools/dev/seedgen.py into gno/r/gnoradio/devseed/v0
// (gitignored): never deploy it outside a devnet. It works only while it is the
// catalog admin (test1: catalog.OfferAdmin(devseed.Address()), then devseed.Take).
package devseed

import (
	"chain"
	"strconv"
	"strings"

	"gno.land/r/gnoradio/catalog/v1"
	"gno.land/r/gnoradio/radio/v1"
)

const owner address = "g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5" // gnodev test1

var (
	ids    []int // artist index -> on-chain id
	bi, li int   // next batch, next line in it
	madeTo int   // artists created so far
)

// Artists creates up to n more artists (kind, name, source; tab-separated in artists).
func Artists(cur realm, n int) int {
	for ; n > 0 && madeTo < len(artists); n-- {
		f := strings.Split(artists[madeTo], "\t")
		ids = append(ids, catalog.CreateArtist(cross(cur), f[0], f[1], "", f[2]))
		madeTo++
	}
	return len(artists) - madeTo
}

// Run imports the next n track lines through radio.ImportTracks (never more than one
// stored batch of 25 a call) and returns how many batches remain. A line's first field is
// "@<artist index>", resolved to the id Artists created. Keep n so a call stays under the
// gas you can offer (an import grows with the stations: about 30M gas a track).
func Run(cur realm, n int) int {
	if madeTo < len(artists) {
		panic("devseed: create the artists first")
	}
	for n > 0 && bi < len(batches) {
		all := strings.Split(batches[bi], "\n")
		end := li + n
		if end > len(all) {
			end = len(all)
		}
		lines := all[li:end]
		for i, l := range lines {
			tab := strings.IndexByte(l, '\t')
			a, _ := strconv.Atoi(l[1:tab])
			lines[i] = strconv.Itoa(ids[a]) + l[tab:]
		}
		radio.ImportTracks(cross(cur), strings.Join(lines, "\n"))
		n -= end - li
		if li = end; li == len(all) {
			bi, li = bi+1, 0
		}
	}
	return len(batches) - bi
}

// Take accepts the catalog admin role test1 offered to this realm.
func Take(cur realm) {
	if cur.Previous().Address() != owner {
		panic("devseed: owner only")
	}
	catalog.AcceptAdmin(cross(cur))
}

// GiveBack offers the catalog admin role back to test1, who then calls catalog.AcceptAdmin.
func GiveBack(cur realm) {
	if cur.Previous().Address() != owner {
		panic("devseed: owner only")
	}
	catalog.OfferAdmin(cross(cur), owner)
}

// Address is this realm's address, to hand it the catalog admin role.
func Address() address { return chain.PackageAddress("gno.land/r/gnoradio/devseed/v0") }
